# =============================================================================
# Production Environment Configuration
# =============================================================================
# Copy this file to .env.production and fill in the values
# IMPORTANT: Never commit .env.production to version control
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
POSTGRES_DB=ai_career_platform

# -----------------------------------------------------------------------------
# Authentication & Security
# -----------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=CHANGE_THIS_SECRET_KEY
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30

# -----------------------------------------------------------------------------
# OAuth (Optional - for Google Sign-In)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://yourdomain.com/api/auth/google/callback

# -----------------------------------------------------------------------------
# Public URLs
# -----------------------------------------------------------------------------
# Your production domain (no trailing slash)
WEB_URL=https://yourdomain.com
NEXT_PUBLIC_API_URL=https://yourdomain.com/api
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# -----------------------------------------------------------------------------
# JobSpy Scraper
# -----------------------------------------------------------------------------
# Generate a random token: openssl rand -hex 16
JOBSPY_API_TOKEN=CHANGE_THIS_JOBSPY_TOKEN
JOBSPY_ALLOW_INSECURE=false
JOBSPY_PROXIES=
JOBSPY_DEFAULT_RESULTS_WANTED=25
JOBSPY_MAX_RESULTS_WANTED=100
JOBSPY_MAX_CONCURRENCY=2
JOBSPY_REQUEST_TIMEOUT_SECONDS=180
JOBSPY_TIMEOUT_MS=200000

# -----------------------------------------------------------------------------
# Queue & Worker Configuration
# -----------------------------------------------------------------------------
QUEUE_PREFIX=aicareer
SCRAPER_CONCURRENCY=2
NOTIFICATIONS_CONCURRENCY=5
SCRAPER_MAX_CONSECUTIVE_FAILURES=10
JOB_STALE_DAYS=14
LOG_RETENTION_DAYS=30

# -----------------------------------------------------------------------------
# AI Configuration
# -----------------------------------------------------------------------------
AI_REQUEST_TIMEOUT_MS=60000
AI_MAX_OUTPUT_TOKENS=1200
AI_MAX_ATTEMPTS=2

# -----------------------------------------------------------------------------
# Billing - Lemon Squeezy (Optional)
# -----------------------------------------------------------------------------
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=
LEMON_SQUEEZY_VARIANT_ID_PRO=
LEMON_SQUEEZY_VARIANT_ID_PREMIUM=

# -----------------------------------------------------------------------------
# Cron Schedules (Optional - defaults provided)
# -----------------------------------------------------------------------------
CRON_DAILY_DIGEST=0 8 * * *
CRON_WEEKLY_DIGEST=0 8 * * 1
CRON_EXPIRE_JOBS=0 2 * * *
CRON_DAILY_STATS=0 1 * * *
CRON_APPLICATION_REMINDERS=0 9 * * *
CRON_PRUNE_LOGS=0 3 * * 0

# -----------------------------------------------------------------------------
# Version (Optional)
# -----------------------------------------------------------------------------
VERSION=1.0.0
