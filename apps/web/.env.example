NEXT_PUBLIC_API_URL=http://localhost:4000/api
# Public origin of this web app (no trailing slash) — used for canonical URLs,
# Open Graph/Twitter absolute URLs, sitemap.xml, and robots.txt. Set to the real
# domain before deploying; NEXT_PUBLIC_* vars are baked in at build time.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
