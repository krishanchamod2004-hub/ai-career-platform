# Server
NODE_ENV=development
PORT=4000

# Database (PostgreSQL via Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_career_platform?schema=public"

# Redis (also used as the BullMQ broker)
REDIS_URL="redis://localhost:6379"

# JWT
JWT_ACCESS_SECRET="replace-with-a-long-random-secret-in-production"
JWT_ACCESS_EXPIRES_IN="15m"
REFRESH_TOKEN_TTL_DAYS=30

# Google OAuth 2.0 (for "Continue with Google")
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Callback URL must match the authorized redirect URI in Google Console
# Format: http://localhost:4000/api/auth/google/callback (development)
#         https://api.yourdomain.com/api/auth/google/callback (production)
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"

# Frontend URL (used for CORS + email links)
WEB_URL="http://localhost:3000"

# --- Phase 2: queues & scraper workers ---------------------------------------
# BullMQ key prefix (isolates environments that share one Redis instance)
QUEUE_PREFIX=aicareer

# Run queue consumers inside the API process (handy locally; use the dedicated
# worker process in production).
RUN_WORKERS_IN_API=false

# Register cron schedules from this process. Exactly ONE process should do this
# — normally the worker container.
ENABLE_SCHEDULER=false

# Worker tuning
SCRAPER_CONCURRENCY=2
NOTIFICATIONS_CONCURRENCY=5
SCRAPER_MAX_CONSECUTIVE_FAILURES=10

# --- JobSpy sidecar (services/jobspy) ----------------------------------------
# Python FastAPI service that scrapes LinkedIn/Indeed/Glassdoor/ZipRecruiter.
# Keep it on loopback: it has no user model of its own.
JOBSPY_SERVICE_URL="http://127.0.0.1:8000"
# Must match JOBSPY_API_TOKEN in services/jobspy/.env
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JOBSPY_API_TOKEN=
# Slightly above the sidecar's own JOBSPY_REQUEST_TIMEOUT_SECONDS (180s).
JOBSPY_TIMEOUT_MS=200000

# Housekeeping
JOB_STALE_DAYS=14
LOG_RETENTION_DAYS=30

# Cron overrides (BullMQ repeatable job patterns, UTC)
CRON_DAILY_DIGEST="0 8 * * *"
CRON_WEEKLY_DIGEST="0 8 * * 1"
CRON_EXPIRE_JOBS="30 3 * * *"
CRON_DAILY_STATS="15 0 * * *"
CRON_APPLICATION_REMINDERS="0 9 * * *"
CRON_PRUNE_LOGS="0 4 * * 0"

# --- Phase 3: AI evaluations (BYOK) ------------------------------------------
# There is intentionally NO provider API key here. Users supply their own
# Anthropic/OpenAI key per request via the x-ai-* headers; it is never persisted.

# --- Billing: Lemon Squeezy --------------------------------------------------
# All optional. Leave blank and the API still boots — /billing/checkout and
# /billing/webhook answer 503 (BILLING_NOT_CONFIGURED) instead of failing at boot.
# Store-scoped API key from Settings > API in the Lemon Squeezy dashboard.
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
# Signing secret you chose when creating the webhook. Must match exactly: the
# X-Signature HMAC is the only authentication on the webhook route.
LEMON_SQUEEZY_WEBHOOK_SECRET=
# Variant ids (Products > variant > "Copy variant ID"), one per paid tier. A
# purchase of any variant not listed here grants nothing, by design.
LEMON_SQUEEZY_VARIANT_ID_PRO=
LEMON_SQUEEZY_VARIANT_ID_PREMIUM=
AI_REQUEST_TIMEOUT_MS=60000
AI_MAX_OUTPUT_TOKENS=1200
# Total attempts per evaluation (each attempt bills the user's own account).
AI_MAX_ATTEMPTS=2

# --- Resumes / ATS scoring ----------------------------------------------------
# Local-disk directory for uploaded resume PDFs. MVP storage: fine for a single
# API instance; a multi-replica deployment needs shared/object storage (S3 or
# equivalent) since an upload landing on one instance must be readable from
# every other instance.
RESUME_UPLOAD_DIR=./uploads/resumes
