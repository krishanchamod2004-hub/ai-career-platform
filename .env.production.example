# =============================================================================
# AI CAREER PLATFORM - PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env in the project root and fill in all required values
# before deploying to your VPS.
#
# SECURITY WARNING: Never commit the actual .env file to version control!
# =============================================================================

# --- Node Environment --------------------------------------------------------
NODE_ENV=production

# --- PostgreSQL Database -----------------------------------------------------
# REQUIRED: Set a strong password for production
# Generate with: openssl rand -base64 32
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=ai_career_platform

# --- Redis Cache & Queue Broker ----------------------------------------------
# Redis runs internally in Docker network - no password needed for internal use
# If exposing Redis externally (not recommended), add authentication

# --- JWT Authentication (REQUIRED) -------------------------------------------
# CRITICAL: Generate strong secrets for production
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30

# --- Google OAuth 2.0 --------------------------------------------------------
# Get credentials from: https://console.cloud.google.com/apis/credentials
# 1. Create OAuth 2.0 Client ID (Web application)
# 2. Add authorized redirect URI: https://api.yourdomain.com/api/auth/google/callback
# 3. Add authorized JavaScript origins: https://yourdomain.com
#
# Leave empty to disable Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.yourdomain.com/api/auth/google/callback

# --- Public URLs (REQUIRED FOR PRODUCTION) -----------------------------------
# CRITICAL: Set these to your actual domains BEFORE building Docker images
# These are baked into the Next.js client bundle at build time

# Frontend domain (e.g., https://yourdomain.com)
WEB_URL=https://yourdomain.com
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# API subdomain (e.g., https://api.yourdomain.com/api)
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api

# --- JobSpy Scraper Service (REQUIRED) ---------------------------------------
# CRITICAL: Generate a strong token for API authentication
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JOBSPY_API_TOKEN=

# JobSpy Configuration
JOBSPY_PROXIES=
JOBSPY_DEFAULT_RESULTS_WANTED=25
JOBSPY_MAX_RESULTS_WANTED=100
JOBSPY_MAX_CONCURRENCY=2
JOBSPY_REQUEST_TIMEOUT_SECONDS=180
JOBSPY_TIMEOUT_MS=200000

# --- Queue Configuration -----------------------------------------------------
QUEUE_PREFIX=aicareer

# Worker Concurrency
SCRAPER_CONCURRENCY=2
NOTIFICATIONS_CONCURRENCY=5
SCRAPER_MAX_CONSECUTIVE_FAILURES=10

# --- Data Housekeeping -------------------------------------------------------
JOB_STALE_DAYS=14
LOG_RETENTION_DAYS=30

# --- AI Configuration --------------------------------------------------------
AI_REQUEST_TIMEOUT_MS=60000
AI_MAX_OUTPUT_TOKENS=1200
AI_MAX_ATTEMPTS=2

# --- Cron Schedules (UTC) ----------------------------------------------------
# Daily digest at 8 AM UTC
CRON_DAILY_DIGEST=0 8 * * *
# Weekly digest every Monday at 8 AM UTC
CRON_WEEKLY_DIGEST=0 8 * * 1
# Expire stale jobs at 2 AM UTC
CRON_EXPIRE_JOBS=0 2 * * *
# Compute daily stats at 1 AM UTC
CRON_DAILY_STATS=0 1 * * *
# Application reminders at 9 AM UTC
CRON_APPLICATION_REMINDERS=0 9 * * *
# Prune old logs every Sunday at 3 AM UTC
CRON_PRUNE_LOGS=0 3 * * 0

# --- Billing Integration (Optional) ------------------------------------------
# LemonSqueezy configuration for subscription billing
# Get credentials from: https://app.lemonsqueezy.com/settings/api
# Leave empty to run without billing integration
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=
LEMON_SQUEEZY_VARIANT_ID_PRO=
LEMON_SQUEEZY_VARIANT_ID_PREMIUM=

# --- Email Configuration (Optional) ------------------------------------------
# If using SMTP for transactional emails
# Leave empty to use console logging (emails will be logged, not sent)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=AI Career Platform

# =============================================================================
# DEPLOYMENT CHECKLIST
# =============================================================================
# Before deploying to production, ensure:
#
# [✓] 1. Generate strong random values for:
#        - JWT_ACCESS_SECRET (64+ bytes hex)
#        - POSTGRES_PASSWORD (32+ bytes)
#        - JOBSPY_API_TOKEN (32+ bytes hex)
#
# [✓] 2. Update all domain URLs:
#        - WEB_URL
#        - NEXT_PUBLIC_SITE_URL
#        - NEXT_PUBLIC_API_URL
#        - GOOGLE_CALLBACK_URL (if using OAuth)
#
# [✓] 3. Configure DNS A records:
#        - yourdomain.com → VPS IP
#        - api.yourdomain.com → VPS IP
#
# [✓] 4. Configure OAuth (if needed):
#        - Create Google OAuth credentials
#        - Add authorized redirect URIs
#
# [✓] 5. Review resource limits:
#        - Adjust worker concurrency based on VPS specs
#        - Tune PostgreSQL settings if needed
#
# [✓] 6. Backup strategy:
#        - Setup automated database backups
#        - Test restore procedure
#
# [✓] 7. Monitoring:
#        - Setup log aggregation
#        - Configure alerts for errors
#        - Monitor disk usage
# =============================================================================
