{
  "name": "@ai-career/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared TypeScript types, DTOs, and constants for AI Career Platform",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint \"src/**/*.ts\"",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "rimraf": "6.0.1",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.0",
    "@typescript-eslint/eslint-plugin": "8.10.0",
    "@typescript-eslint/parser": "8.10.0"
  }
}
