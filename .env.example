# =============================================================================
# AI CAREER PLATFORM - ENVIRONMENT CONFIGURATION (EXAMPLE)
# =============================================================================
# Copy this file to .env in the project root and fill in the values.
# Required for both Docker Compose and local development.
# =============================================================================

# --- Server Configuration ----------------------------------------------------
NODE_ENV=development
PORT=4000

# --- Database (PostgreSQL) ---------------------------------------------------
# Connection string format: postgresql://user:password@host:port/database?schema=public
# Docker: Use service name as host (postgres)
# Local: Use localhost with your PostgreSQL credentials
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_career_platform?schema=public"

# --- Redis Cache & Queue Broker ----------------------------------------------
# Docker: redis://redis:6379
# Local: redis://localhost:6379
REDIS_URL="redis://localhost:6379"

# --- JWT Authentication (REQUIRED) -------------------------------------------
# Generate secure secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MUST be set before starting the API (NestJS validation will fail if missing)
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN="15m"
REFRESH_TOKEN_TTL_DAYS=30

# --- Google OAuth 2.0 (REQUIRED - Application uses OAuth-only authentication) ---
# Get credentials from: https://console.cloud.google.com/apis/credentials
# 1. Create OAuth 2.0 Client ID (Web application)
# 2. Add authorized redirect URI: http://localhost:4000/api/auth/google/callback
# See GOOGLE_OAUTH_SETUP.md for detailed setup instructions
#
# CRITICAL: These MUST be set or the API will crash on startup.
# The application now uses Google OAuth exclusively - email/password login has been removed.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"

# --- Frontend & CORS ---------------------------------------------------------
# Public URL of the web app (used for CORS and email links)
WEB_URL="http://localhost:3000"

# Public URL of the API (baked into Next.js client bundle at build time)
# Production: Set to your real domain BEFORE building: docker compose build web
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# Public origin of the web app (for canonical URLs, OG tags, sitemap)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- BullMQ Queue Configuration ----------------------------------------------
# Key prefix to isolate environments sharing one Redis instance
QUEUE_PREFIX="aicareer"

# Run queue consumers inside the API process (convenient for local development)
# Production: Set to false and use dedicated worker process
RUN_WORKERS_IN_API=false

# Register cron schedules from this process
# Exactly ONE process should set this to true (normally the worker container/process)
ENABLE_SCHEDULER=false

# Worker concurrency settings
SCRAPER_CONCURRENCY=2
NOTIFICATIONS_CONCURRENCY=5
SCRAPER_MAX_CONSECUTIVE_FAILURES=10

# --- JobSpy Scraper Sidecar (REQUIRED for job scraping) ----------------------
# Python FastAPI service for LinkedIn/Indeed/Glassdoor/ZipRecruiter
# Docker: http://jobspy:8000
# Local: http://127.0.0.1:8000 (if running JobSpy service locally)
JOBSPY_SERVICE_URL="http://127.0.0.1:8000"

# Shared authentication token between API and JobSpy service
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MUST match JOBSPY_API_TOKEN in services/jobspy/.env
JOBSPY_API_TOKEN=

# Request timeout (slightly above JobSpy's own timeout)
JOBSPY_TIMEOUT_MS=200000

# JobSpy optional configuration (leave blank for defaults)
# Comma-separated proxies (user:pass@host:port) for LinkedIn rate limiting
JOBSPY_PROXIES=
JOBSPY_DEFAULT_RESULTS_WANTED=25
JOBSPY_MAX_RESULTS_WANTED=100
JOBSPY_MAX_CONCURRENCY=2
JOBSPY_REQUEST_TIMEOUT_SECONDS=180

# --- Data Housekeeping -------------------------------------------------------
JOB_STALE_DAYS=14
LOG_RETENTION_DAYS=30

# --- Cron Schedules (UTC) ----------------------------------------------------
# BullMQ repeatable job patterns (optional overrides)
CRON_DAILY_DIGEST="0 8 * * *"
CRON_WEEKLY_DIGEST="0 8 * * 1"
CRON_EXPIRE_JOBS="30 3 * * *"
CRON_DAILY_STATS="15 0 * * *"
CRON_APPLICATION_REMINDERS="0 9 * * *"
CRON_PRUNE_LOGS="0 4 * * 0"

# --- AI Evaluations (BYOK - Bring Your Own Key) ------------------------------
# Users supply their own Anthropic/OpenAI keys via x-ai-* request headers
# No API keys are stored in environment variables (intentional design)
AI_REQUEST_TIMEOUT_MS=60000
AI_MAX_OUTPUT_TOKENS=1200
AI_MAX_ATTEMPTS=2

# --- Lemon Squeezy Billing (OPTIONAL) ----------------------------------------
# Leave ALL blank to run without billing integration
# App will boot normally, billing endpoints return 503, upgrade buttons show disabled
#
# Setup instructions:
# 1. Create store at https://app.lemonsqueezy.com
# 2. Get API key from Settings > API
# 3. Create webhook for: https://api.yourdomain.com/api/billing/webhook
# 4. Subscribe to: subscription_created, subscription_updated, subscription_cancelled,
#    subscription_expired, subscription_resumed
# 5. Get variant IDs from Products > Variants > Copy variant ID
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=
LEMON_SQUEEZY_VARIANT_ID_PRO=
LEMON_SQUEEZY_VARIANT_ID_PREMIUM=

# --- Resume Upload Storage ---------------------------------------------------
# Local filesystem path for uploaded resume PDFs
# Production: Consider using S3 or equivalent object storage for multi-instance deployments
RESUME_UPLOAD_DIR="./uploads/resumes"
