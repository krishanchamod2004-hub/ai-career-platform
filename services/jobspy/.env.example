# --- transport ---------------------------------------------------------------
# Keep on loopback: this service has no user model and must sit behind the API.
JOBSPY_HOST=127.0.0.1
JOBSPY_PORT=8000

# Shared secret; the NestJS API sends it as the X-JobSpy-Token header.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JOBSPY_API_TOKEN=

# Set to true ONLY for local experiments without a token.
JOBSPY_ALLOW_INSECURE=false

# --- proxies -----------------------------------------------------------------
# Comma-separated: user:pass@host:port, host:port, or localhost.
# JobSpy round-robins per job board. LinkedIn rate-limits a single IP within
# roughly 10 pages, so residential proxies are effectively required there.
JOBSPY_PROXIES=
# Some MITM proxy vendors need their CA bundle:
JOBSPY_CA_CERT=

# --- scraping behaviour ------------------------------------------------------
# html -> RawJob.descriptionHtml (Node converts to text); markdown -> descriptionText
JOBSPY_DESCRIPTION_FORMAT=html
# LinkedIn search results omit descriptions; fetching them costs +1 request per
# posting but is required for AI evaluation to have anything to score.
JOBSPY_LINKEDIN_FETCH_DESCRIPTION=true
JOBSPY_ENFORCE_ANNUAL_SALARY=false
# Override JobSpy's built-in UA if it goes stale.
JOBSPY_USER_AGENT=
# 0 errors, 1 errors+warnings, 2 all
JOBSPY_VERBOSE=1

# --- limits ------------------------------------------------------------------
JOBSPY_DEFAULT_RESULTS_WANTED=25
JOBSPY_MAX_RESULTS_WANTED=100
JOBSPY_MAX_CONCURRENCY=2
JOBSPY_REQUEST_TIMEOUT_SECONDS=180
