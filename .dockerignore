# =============================================================================
# Docker Build Context Ignore
# Minimizes context sent to Docker daemon for faster builds
# =============================================================================

# Git
.git
.gitignore
.gitattributes
.github

# Documentation
*.md
!README.md
docs/

# IDE
.vscode
.idea
*.swp
*.swo
*~
.DS_Store

# Dependencies (will be installed fresh)
node_modules
**/node_modules
.pnpm-store
.npm
.yarn

# Build outputs (will be rebuilt)
dist
**/dist
build
**/build
.next
**/.next
out
**/out
*.tsbuildinfo
**/*.tsbuildinfo

# Test files
test
tests
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
coverage
.nyc_output
jest.config.js
jest.config.ts

# Environment files
.env
.env.*
!.env.example
!.env.*.example
!.env.*.template

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Local development
.local
.dev
temp
tmp
*.tmp

# Python
__pycache__
**/__pycache__
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache
.mypy_cache
.venv
venv
ENV
env

# Database
*.db
*.sqlite
*.sqlite3
prisma/migrations/**/*.sql.REMOVED

# Docker
Dockerfile*
docker-compose*.yml
.dockerignore

# Deployment
scripts
nginx
deploy
deployment

# Uploads
uploads
upload

# Cache
.cache
.parcel-cache
.turbo

# OS
Thumbs.db
Desktop.ini
.AppleDouble
.LSOverride

# Backups
*.bak
*.backup
backup
backups
